# Azure Speech runtime config for woong-bb
# 이 파일을 복사해서 `azure-speech.env` 또는 `session/azure-speech.env`로 사용한다.
# 실제 키는 저장소에 커밋하지 않는다.

# Azure Portal > Speech resource > Keys and Endpoint 에서 확인
AZURE_SPEECH_KEY=

# 예: koreacentral, eastus, japaneast
AZURE_SPEECH_REGION=

# 선택: Portal에 endpoint가 따로 보이면 넣고, 보이지 않으면 비워둬도 됨
AZURE_SPEECH_ENDPOINT=

# 기본 출력 언어
AZURE_SPEECH_LOCALE=ko-KR

# 시작용 기본 음성
# 추천: ko-KR-SunHiNeural, ko-KR-JiMinNeural
AZURE_SPEECH_VOICE=ko-KR-SunHiNeural

# 출력 포맷
# 예: audio-24khz-48kbitrate-mono-mp3
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# 말속도. SSML rate 값 기준
# 예: 0%, -5%, +3%
AZURE_SPEECH_RATE=-3%

# 음높이. SSML pitch 값 기준
# 예: 0%, +2%, -2%
AZURE_SPEECH_PITCH=0%

# 볼륨. SSML volume 값 기준
# 예: default, soft, x-soft, medium
AZURE_SPEECH_VOLUME=medium

# 음성 파일 저장 루트
AZURE_SPEECH_OUTPUT_DIR=/Users/kein/Desktop/woong-bb/voice-message

# 텔레그램 음성 자동 전송 허용 여부
# true / false
WOONGBB_VOICE_SEND_ENABLED=false

# 음성 생성 1회 최대 문자 수 제한
WOONGBB_VOICE_MAX_CHARS=220
