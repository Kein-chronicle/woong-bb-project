      "start_ms": 484259,
      "duration_ms": 5160,
      "text": "싶지 않아 좋은 생각만 하기도 되게"
    },
    {
      "start_ms": 487500,
      "duration_ms": 3479,
      "text": "바쁘단 말이에요"
    },
    {
      "start_ms": 489419,
      "duration_ms": 4500,
      "text": "스트레스가 많고"
    },
    {
      "start_ms": 490979,
      "duration_ms": 6840,
      "text": "단명하고 멍이가 장수한다니까 진짜로"
    },
    {
      "start_ms": 493919,
      "duration_ms": 5761,
      "text": "생각이 깊으니까 그만큼 사람이 세심해"
    },
    {
      "start_ms": 497819,
      "duration_ms": 4950,
      "text": "그리고 다정하고 그게 좋아요"
    },
    {
      "start_ms": 506699,
      "duration_ms": 4940,
      "text": "햄버거 뭐 도너츠 가족들이랑 먹으라고"
    },
    {
      "start_ms": 513020,
      "duration_ms": 4560,
      "text": "내가 오히려 근데 받은게 더 많아"
    },
    {
      "start_ms": 515159,
      "duration_ms": 2421,
      "text": "어머님한테"
    },
    {
      "start_ms": 518940,
      "duration_ms": 5880,
      "text": "회무침 나도 그렇게 따지면 어머님이"
    },
    {
      "start_ms": 521099,
      "duration_ms": 5641,
      "text": "꽃게 그보다 사과 그리고 머니가 그런"
    },
    {
      "start_ms": 524820,
      "duration_ms": 3300,
      "text": "말을 했어 우리 집에도 한번 자는데"
    },
    {
      "start_ms": 526740,
      "duration_ms": 3360,
      "text": "최근에"
    },
    {
      "start_ms": 528120,
      "duration_ms": 2540,
      "text": "서로가 등을 돌리고 서로 핸드폰"
    },
    {
      "start_ms": 530100,
      "duration_ms": 4460,
      "text": "하면서"
    },
    {
      "start_ms": 530660,
      "duration_ms": 3900,
      "text": "시간을 보내고 있었어 평소처럼"
    },
    {
      "start_ms": 534839,
      "duration_ms": 3361,
      "text": "근데 요만 진짜 너무 이러고 있으니까"
    },
    {
      "start_ms": 536640,
      "duration_ms": 4220,
      "text": "난 이러고 있어도 너무 좋아 이렇게"
    },
    {
      "start_ms": 538200,
      "duration_ms": 2660,
      "text": "말하는 거야"
    },
    {
      "start_ms": 542040,
      "duration_ms": 4140,
      "text": "근데 우리가이 말을 되게 자주 해"
    },
    {
      "start_ms": 544080,
      "duration_ms": 3900,
      "text": "굳이 뭔가 함께 하지 않고 뭐 서로"
    },
    {
      "start_ms": 546180,
      "duration_ms": 4740,
      "text": "등 돌리고 있으면 어때 우리가 지금"
    },
    {
      "start_ms": 547980,
      "duration_ms": 4400,
      "text": "이러고 있는게 너무 좋고 행복하잖아"
    },
    {
      "start_ms": 552380,
      "duration_ms": 5139,
      "text": "어 저기 써있다 기안84 해 놓고"
    },
    {
      "start_ms": 555959,
      "duration_ms": 3681,
      "text": "옆으로 가면 될 거 같은데"
    },
    {
      "start_ms": 557519,
      "duration_ms": 2121,
      "text": "맛있겠다"
    },
    {
      "start_ms": 561779,
      "duration_ms": 3001,
      "text": "그렇게 생각"
    },
    {
      "start_ms": 563580,
      "duration_ms": 4349,
      "text": "아 맛있겠다"
    },
    {
      "start_ms": 578820,
      "duration_ms": 2959,
      "text": "그러니까 작은 고추가 원래대로"
    },
    {
      "start_ms": 583560,
      "duration_ms": 3080,
      "text": "작은 고추가 원래 맵다고"
    },
    {
      "start_ms": 590880,
      "duration_ms": 3360,
      "text": "낚시 가고 싶어"
    },
    {
      "start_ms": 592260,
      "duration_ms": 4560,
      "text": "그렇게 국물 먹으니까"
    },
    {
      "start_ms": 594240,
      "duration_ms": 4700,
      "text": "맛은 있어요 맛은 있는데 아쉬워요"
    },
    {
      "start_ms": 596820,
      "duration_ms": 12500,
      "text": "또는 안 먹을 것 같아요"
    }
  ]
}