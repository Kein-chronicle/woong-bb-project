# ElevenLabs runtime config for woong-bb
# 이 파일을 복사해서 `elevenlabs.env` 또는 `session/elevenlabs.env`로 사용한다.
# 실제 키는 저장소에 커밋하지 않는다.

# ElevenLabs API key
ELEVENLABS_API_KEY=

# 나중에 클론 생성 후 넣을 고유 voice id
ELEVENLABS_VOICE_ID=

# 모델명
# 예: eleven_multilingual_v2, eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 출력 포맷
# 예: mp3_44100_128
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# 안정성/유사도/스타일 값은 나중에 튜닝
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_STYLE=0.18
ELEVENLABS_USE_SPEAKER_BOOST=true

# 음성 파일 저장 루트
ELEVENLABS_OUTPUT_DIR=/Users/kein/Desktop/woong-bb/voice-message

# 텔레그램 음성 자동 전송 허용 여부
WOONGBB_VOICE_SEND_ENABLED=false

# 음성 생성 1회 최대 문자 수 제한
WOONGBB_VOICE_MAX_CHARS=220
